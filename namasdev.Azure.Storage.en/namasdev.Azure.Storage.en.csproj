<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net9.0</TargetFrameworks>
    <AssemblyName>namasdev.Azure.Storage.en</AssemblyName>
    <RootNamespace>namasdev.Azure.Storage.en</RootNamespace>    
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <Authors>Matias Alberto Lopez</Authors>
    <Description>namasdev Azure Storage library (English)</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © 2025 Matias Alberto Lopez</Copyright>
    <PackageTags>namasdev</PackageTags>
    <PackageProjectUrl>https://github.com/MatiasALopez/namasdev.Azure.Storage.en</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MatiasALopez/namasdev.Azure.Storage.en</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.22.0" />
    <PackageReference Include="namasdev.Core.en" Version="[0.1.2,0.2.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
